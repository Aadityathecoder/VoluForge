# Public app configuration. Never put a Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
# EAS project UUID from your own Expo account after eas init.
EAS_PROJECT_ID=
# Confirm an identifier registered under your Apple developer team.
IOS_BUNDLE_IDENTIFIER=com.aadityamitra.voluforge
